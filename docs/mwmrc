! ~/.config/mwc/mwmrc: read at startup and on reload (root menu, or SIGHUP).
! No comments after a value on the same line.

! Desktop picture. A set MWC_WALLPAPER takes precedence.
! Mwm*wallpaper:                         ~/pictures/wallpaper.png

! Desktop colour, shown where no wallpaper covers it: SGI teal ("sgi teal"
! in X11's rgb.txt). Other SGI/IRIX variants:
!   #729C9C   Indigo Magic AlternateBackground4, light grey-green
!   #5680AB   Indigo Magic AlternateBackground5, muted cadet blue
!   #7171C6   sgi slateblue (rgb.txt)
!   #555555   plain X11 root grey, dark
!   #7F7F7F   plain X11 root grey, light
Mwm*rootBackground:                    #388E8E

! Terminal for New Window and Super+Return. A set MWC_TERMINAL takes precedence.
Mwm*terminal:                          mwt -a indigo
Mwm*mwt*activeBackground:              #2e5e3e

! Tiling: only these tile, everything else floats.
Mwm*TileOnly:                          mwt, indigo, dracula, amber, paper

! Firefox: chocolate brown.
! Navigator is its WM_CLASS under X11. Natively on Wayland it goes by its app_id
! instead, and that is firefox_firefox for the snap.
Mwm*Navigator*activeBackground:        #7b3f00
Mwm*firefox_firefox*activeBackground:  #7b3f00
Mwm*firefox*activeBackground:          #7b3f00
Mwm*mfm*activeBackground:              gold

! Programs at the top of the root menu.
Mwm*rootMenuItem:                      Firefox: firefox
Mwm*rootMenuItem:                      Dateien: mfm
Mwm*rootMenuItem:                      Ausführen: mrun
Mwm*rootMenuItem:                      Starfield: displayOff --stars
Mwm*rootMenuItem:                      Display Off: displayOff --now

! The dock, bottom right: digitalClock in the corner, then pulseControl, osDisplay
! and deskControl to its left, in the order of these lines. Docked windows are on
! every desktop. Start them from ~/.config/mwc/autostart, one line "NAME &" each.
Mwm*digitalClock*dock:         true
Mwm*pulseControl*dock:         true
Mwm*osDisplay*dock:            true
Mwm*deskControl*dock:          true
Mwm*dockPlacement:             right bottom

! mrun (middle button, root menu) opens at the pointer. Needs mwc 0.4.3.
Mwm*mrun*geometry:          pointer

! Print: a rectangle to the clipboard, Shift+Print the whole screen there. Ctrl+Print:
! a rectangle to a file, Ctrl+Shift+Print the whole screen. These are the defaults.
Mwm*clipboardRectangleScreenshot:   screenShot -c -r
Mwm*clipboardScreenshot:            screenShot -c
Mwm*rectangleScreenshot:            screenShot -r
Mwm*screenshot:                     screenShot

! Icons: a column down from the top right corner.
Mwm*iconPlacement:   top right

! The icons in a box of their own, at most 10 long; the mwc logo while it is empty.
Mwm*useIconBox:      true
Mwm*iconBoxSize:     10
