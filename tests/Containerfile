# All of make test, headless, with nothing installed on the host but Podman.
# The packages are the ones in distrobox.ini, and what a bare image lacks for the
# tests (keymaps, a font, a cursor theme, ps). git: mwc -v names the commit built.
#
#   podman build -t mwc-test -f tests/Containerfile tests
#   podman run --rm --network=none -v "$PWD:/src/mwc:ro" mwc-test \
#       sh -c 'cp -r /src/mwc /tmp/mwc && cd /tmp/mwc && make clean && make -k test'
#
# The sources stay read-only and the build happens in a copy; make clean drops what
# a host build left in build/.
FROM docker.io/library/archlinux:latest
# valgrind needs glibc's symbols, which Arch ships apart; the tests run offline,
# without debuginfod.
RUN printf '[core-debug]\nServer = https://geo.mirror.pkgbuild.com/$repo/os/$arch\n' \
    >>/etc/pacman.conf
RUN pacman -Syu --noconfirm --needed \
    base-devel pkgconf wlroots0.20 \
    wayland wayland-protocols libxkbcommon pixman cairo pango \
    foot grim xkeyboard-config ttf-dejavu adwaita-icon-theme procps-ng valgrind \
    clang compiler-rt git glibc-debug \
    && pacman -Scc --noconfirm
RUN useradd -m tester
USER tester
ENV XDG_RUNTIME_DIR=/tmp/xdg
RUN mkdir -m 700 /tmp/xdg
WORKDIR /home/tester
