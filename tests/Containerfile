# All of make test, headless, with nothing installed on the host but Podman.
# The packages are the ones in distrobox.ini.
#
#   podman build -t mwc-test -f tests/Containerfile tests
#   podman run --rm --network=none --tmpfs /tmp/.X11-unix:mode=1777 \
#       -v "$PWD:/src/mwc:ro" mwc-test \
#       sh -c 'cp -r /src/mwc /tmp/mwc && cd /tmp/mwc && make clean && make -k test'
#
# The sources stay read-only and the build happens in a copy; make clean drops what
# a host build left in build/. The tmpfs for /tmp/.X11-unix: see distrobox.ini.
FROM docker.io/library/ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config libwlroots-0.19-dev \
    wayland-protocols libwayland-dev libxkbcommon-dev \
    libpixman-1-dev libcairo2-dev libpango1.0-dev xwayland \
    libxcb1-dev libxcb-icccm4-dev libx11-dev \
    xterm foot grim xkb-data fonts-dejavu-core procps \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m tester
USER tester
ENV XDG_RUNTIME_DIR=/tmp/xdg
RUN mkdir -m 700 /tmp/xdg
WORKDIR /home/tester
